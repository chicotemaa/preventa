WORKER_URL=http://127.0.0.1:4000
# Acceso privado obligatorio en produccion. Nunca usar NEXT_PUBLIC_ para secretos.
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=
# Misma clave en web (server-side) y worker, distinta de CRON_SECRET.
WORKER_API_SECRET=
CATEGORY_SEARCH_MODE=catalog
NEXT_PUBLIC_TARGET_GROSS_MARGIN_PERCENT=20
ENABLE_LIVE_SEARCH=false
CRON_SECRET=
WORKER_CRON_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PERSIST_PRICE_LISTS=true
ALERT_CATEGORY_QUERIES=alfajores,jugos en polvo,galletitas,mermeladas,chocolates,salsas y aderezos,cereales y barritas,golosinas
ALERT_CATEGORY_TIMEOUT_MS=20000
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Aguiar Alertas <alertas@tu-dominio.com>
